<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>WinNetFix</AssemblyName>
    <RootNamespace>WinNetFix</RootNamespace>
    <Version>0.1.6</Version>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- 注意：不能开 InvariantGlobalization，否则 CodePagesEncodingProvider 无法提供 GBK/936，
         导致 netsh 中文输出解码失败（TypeInitializationException） -->
    <!-- 托盘为纯 P/Invoke 实现（TrayIcon.cs），无 WinForms 依赖，可安全裁剪 -->
    <PublishTrimmed>true</PublishTrimmed>
    <DebugType>embedded</DebugType>
    <!-- exe 应用图标（托盘图标运行时用 ExtractIconEx 从 exe 提取） -->
    <ApplicationIcon>assets\WinNetFix.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- 防止裁剪掉代码页编码（GBK/936），否则 netsh 中文输出无法解码 -->
  <ItemGroup>
    <TrimmerRootAssembly Include="System.Text.Encoding.CodePages" />
  </ItemGroup>

</Project>
